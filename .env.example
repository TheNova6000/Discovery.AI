NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-local-dev

# Zero-cost LLM providers (see Implimentation-Research/Free-LLM-APIs.md)
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=

# --- Deployment / auth (leave both blank for local/no-login dev) ---
# From your Supabase project: Settings -> API -> JWT Secret. Setting this is
# what turns login ON for the backend (backend/api/auth.py) — every /chat,
# /graph, /sessions request then requires a valid Supabase-issued bearer token.
SUPABASE_JWT_SECRET=
# Comma-separated allowlist of frontend origins allowed to call this API
# cross-origin (e.g. your Vercel URL). Leave blank/unset for "*", which is
# fine for same-origin local/VM use but should be tightened once deployed.
CORS_ORIGINS=
