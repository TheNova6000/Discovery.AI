NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-local-dev

# Zero-cost LLM providers -- get a free key from at least one:
# Groq: console.groq.com/keys | Gemini: aistudio.google.com/apikey | Cerebras: cloud.cerebras.ai
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=

# --- Deployment / auth (leave both blank for local/no-login dev) ---
# Same Supabase project URL the frontend uses (e.g. https://xxxx.supabase.co).
# Setting this is what turns login ON for the backend (backend/api/auth.py) —
# every /chat, /graph, /sessions request then requires a valid Supabase-issued
# bearer token, verified against the project's public JWKS (no shared secret
# needed).
SUPABASE_URL=
# Comma-separated allowlist of frontend origins allowed to call this API
# cross-origin (e.g. your Vercel URL). Leave blank/unset for "*", which is
# fine for same-origin local/VM use but should be tightened once deployed.
CORS_ORIGINS=
# Postgres connection string (Supabase project -> Settings -> Database ->
# Connection string -> URI). Setting this makes sessions/chat history survive
# restarts and Render's free-tier spin-down by persisting them to Postgres
# instead of process memory (backend/api/db.py). Leave blank for local/VM dev.
DATABASE_URL=
