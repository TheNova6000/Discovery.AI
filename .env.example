NEO4J_URI=bolt://localhost:7687
# Neo4j Aura (2025+ instances): the username is the instance id (the first
# label of the neo4j+s://<id>.databases.neo4j.io host), not "neo4j" -- "neo4j"
# fails with Neo.ClientError.Security.Unauthorized (seen 2026-10-28).
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-local-dev

# Zero-cost LLM providers -- get a free key from at least one:
# Groq: console.groq.com/keys | Gemini: aistudio.google.com/apikey | Cerebras: cloud.cerebras.ai
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
COHERE_API_KEY=
# Key pools (preferred): several free-tier keys per provider, comma-separated.
# The pool rotates start keys, cools a key after a timeout/429, and falls
# through to the next provider (backend/llm/client.py). Groq is tried first.
GEMINI_API_KEYS=
GROQ_API_KEYS=

# --- Deployment / auth (leave both blank for local/no-login dev) ---
# Same Supabase project URL the frontend uses (e.g. https://xxxx.supabase.co).
# Setting this is what turns login ON for the backend (backend/api/auth.py) —
# every /chat, /graph, /sessions request then requires a valid Supabase-issued
# bearer token, verified against the project's public JWKS (no shared secret
# needed).
SUPABASE_URL=
# Comma-separated allowlist of frontend origins allowed to call this API
# cross-origin (e.g. your Vercel URL). Leave blank/unset for "*", which is
# fine for same-origin local/VM use but should be tightened once deployed.
CORS_ORIGINS=
# Postgres connection string (Supabase project -> Settings -> Database ->
# Connection string -> URI). Setting this makes sessions/chat history survive
# restarts and Render's free-tier spin-down by persisting them to Postgres
# instead of process memory (backend/api/db.py). Leave blank for local/VM dev.
DATABASE_URL=

# --- Main block (backend/main_block) — all optional, defaults shown ---
# Dewey Archive (research engine's passage store); SQLite file at the repo root.
# DEWEY_ARCHIVE_PATH=dewey_archive.sqlite3
# DEWEY_FETCH=on                 # off = never read full pages (offline/no-network runs)
# EVIDENCE_SOURCE=dewey          # retrievers = old direct-to-sources path
# EVIDENCE_FAITHFULNESS=on       # off = skip the claim-vs-source check
# MAINBLOCK_DB_PATH=mainblock.sqlite3
# MAINBLOCK_MAX_CONCURRENT_JOBS=1
# MAINBLOCK_URL=                 # set to call a main block running as its own service

# --- Tuni'n chat model (backend/chat) ---
# TUNIN_CHAT_MODELS=groq/openai/gpt-oss-20b,google/gemma-4-26b-a4b-it
# TUNIN_CHAT_DB_PATH=tunin_chat.sqlite3
